{
  "name": "checkmarx-ast-azure-plugin",
  "version": "0.0.0",
  "description": "Add Secure Static Source Code Analysis inside your build process",
  "main": "index.js",
  "repository": "https://github.com/checkmarx/ast-azure-plugin",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsc -b cxAstScan/tsconfig.json && tsc -b ui/enhancer/tsconfig.json",
    "test": "npm run build && mocha cxAstScan/dist/test/_suite.js --exit",
    "coverage": "nyc npm run test",
    "lint": "eslint . --ext .ts",
    "lint-and-fix": "eslint . --ext .ts --fix"
  },
  "author": "Checkmarx",
  "license": "SEE LICENSE IN checkmarx-license-terms.md",
  "dependencies": {
    "nyc": "^18.0.0",
    "typescript-logging": "2.2.0",
    "vss-web-extension-sdk": "5.141.0",
    "@babel/helpers": "^7.27.0"
  },
  "devDependencies": {
    "@types/mocha": "10.0.7",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^5.61.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "mocha": "10.7.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "brace-expansion": "2.1.7",
    "tar": "7.5.21",
    "js-yaml": "4.3.2",
    "uuid": "11.1.1",
    "browserslist": "4.28.7",
    "adm-zip": "0.6.1",
    "codecov": {
      "js-yaml": "4.3.2"
    },
    "@humanwhocodes/config-array": {
      "minimatch": {
        ".": "11.0.1",
        "brace-expansion": "5.0.12"
      }
    },
    "@eslint/eslintrc": {
      "minimatch": {
        ".": "11.0.1",
        "brace-expansion": "5.0.12"
      }
    },
    "eslint": {
      "minimatch": {
        ".": "11.0.1",
        "brace-expansion": "5.0.12"
      }
    },
    "glob": {
      "minimatch": {
        ".": "11.0.1",
        "brace-expansion": "5.0.12"
      }
    },
    "nyc": {
      "glob": {
        ".": "14.0.3",
        "minimatch": {
          ".": "11.0.1",
          "brace-expansion": "5.0.12"
        }
      },
      "test-exclude": {
        "minimatch": {
          ".": "11.0.1",
          "brace-expansion": "5.0.12"
        }
      }
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
